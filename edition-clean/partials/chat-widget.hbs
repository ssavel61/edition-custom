{{!--
  Mind Over Money chat widget. Talks to the Cloudflare Worker RAG backend
  (see /chat-agent in the repo). Stays completely hidden until you set
  CHAT_ENDPOINT below to your deployed Worker's /chat URL.
--}}
<style>
  .mom-chat-launcher {
    position: fixed; bottom: 24px; right: 24px; z-index: 99999;
    display: flex; align-items: center; gap: 9px;
    height: 52px; padding: 0 20px 0 17px; border: 1px solid #fff; border-radius: 100px;
    background: #2c353c; color: #fff; cursor: pointer;
    box-shadow: 0 8px 22px rgba(44,53,60,0.34);
    font-family: var(--gh-font-body, -apple-system, system-ui, sans-serif);
    font-size: 1.45rem; font-weight: 700; line-height: 1;
    transition: transform .15s ease, background .15s ease;
  }
  .mom-chat-launcher:hover { transform: translateY(-2px); background: #1f262b; }
  .mom-chat-launcher svg { width: 22px; height: 22px; color: #8abfc5; }
  .mom-chat-launcher-label { white-space: nowrap; }

  .mom-chat-panel {
    position: fixed; bottom: 88px; right: 24px; z-index: 100000;
    width: 380px; max-width: calc(100vw - 32px);
    height: 560px; max-height: calc(100vh - 130px);
    background: #fff; border-radius: 16px; overflow: hidden;
    box-shadow: 0 12px 40px rgba(44,53,60,0.25);
    display: none; flex-direction: column;
    font-family: var(--gh-font-body, -apple-system, system-ui, sans-serif);
  }
  .mom-chat-panel.open { display: flex; }

  .mom-chat-header {
    background: #2c353c; color: #fff; padding: 16px 18px;
    display: flex; align-items: center; justify-content: space-between;
  }
  .mom-chat-header h3 { margin: 0; font-size: 1.5rem; font-weight: 700; color: #fff !important; }
  .mom-chat-header p { margin: 2px 0 0; font-size: 1.2rem; color: rgba(255,255,255,0.8) !important; }
  .mom-chat-close { background: none; border: none; color: #fff; cursor: pointer;
    font-size: 2rem; line-height: 1; opacity: .8; }
  .mom-chat-actions { display:flex; align-items:center; gap:12px; }
  .mom-chat-reset { background:none; border:1px solid rgba(255,255,255,.6); border-radius:6px; color:#fff; padding:4px 7px; cursor:pointer; font-size:1.2rem; }
  .mom-chat-notice { margin-top:6px; color:#4b5e6a; font-size:1.3rem; }
  .mom-chat-retry { margin-top:6px; padding:5px 10px; background:#fff; color:#2c353c; border:1px solid #8abfc5; border-radius:6px; cursor:pointer; }
  .mom-chat-close:hover { opacity: 1; }

  .mom-chat-body { flex: 1; overflow-y: auto; padding: 16px; background: #f4f6f7; }
  .mom-chat-msg { margin-bottom: 14px; font-size: 1.5rem; line-height: 1.6; }
  .mom-chat-msg .bubble { display: inline-block; padding: 11px 15px; border-radius: 14px; max-width: 92%; text-align: left; }
  .mom-chat-msg.user { text-align: right; }
  .mom-chat-msg.user .bubble { background: #2c353c !important; color: #fff !important; border-bottom-right-radius: 4px; }
  .mom-chat-msg.bot .bubble { background: #fff !important; color: #232c33 !important; border: 1px solid #d7dee1; border-bottom-left-radius: 4px; }
  .mom-chat-msg .bubble strong { font-weight: 700; }
  .mom-chat-sources { margin-top: 8px; }
  .mom-chat-sources a { display: block; font-size: 1.25rem; color: #5a8a90; text-decoration: none; padding: 4px 0; border-top: 1px solid #e1e7e9; }
  .mom-chat-sources a:hover { color: #2c353c; }
  .mom-chat-sources .label { font-size: 1.1rem; text-transform: uppercase; letter-spacing: .04em; color: #9aa7ab; margin-top: 6px; }

  .mom-chat-input { display: flex; gap: 8px; padding: 12px; border-top: 1px solid #e1e7e9; background: #fff; }
  .mom-chat-input textarea {
    flex: 1; resize: none; border: 1px solid #d5dee0; border-radius: 10px;
    padding: 10px 12px; font-size: 1.4rem; font-family: inherit; max-height: 100px; color: #232c33;
  }
  .mom-chat-input textarea:focus { outline: none; border-color: #8abfc5; }
  .mom-chat-send { border: none; background: #8abfc5; color: #fff; border-radius: 10px;
    padding: 0 16px; font-weight: 700; cursor: pointer; font-size: 1.4rem; }
  .mom-chat-send:disabled { opacity: .5; cursor: default; }

  @media (max-width: 480px) {
    .mom-chat-panel { left: 8px; right: 8px; width: auto; bottom: 80px; height: calc(100vh - 110px); }
    .mom-chat-launcher { right: 16px; bottom: 16px; }
  }
</style>

<button class="mom-chat-launcher" id="mom-chat-launcher" aria-label="Ask Neura" hidden>
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/></svg>
  <span class="mom-chat-launcher-label">Ask Neura</span>
</button>

<div class="mom-chat-panel" id="mom-chat-panel" role="dialog" aria-label="Content assistant">
  <div class="mom-chat-header">
    <div>
      <h3>Neura AI Assistant</h3>
      <p>Your Content Guide</p>
    </div>
    <div class="mom-chat-actions"><button class="mom-chat-reset" id="mom-chat-reset" type="button">New chat</button>
    <button class="mom-chat-close" id="mom-chat-close" aria-label="Close">&times;</button></div>
  </div>
  <div class="mom-chat-body" id="mom-chat-body"></div>
  <div class="mom-chat-input">
    <textarea id="mom-chat-text" rows="1" maxlength="2000" placeholder="e.g. Where should I start with AI agents?"></textarea>
    <button class="mom-chat-send" id="mom-chat-send">Send</button>
  </div>
</div>

<script>
(function () {
  var CHAT_ENDPOINT = "https://mindovermoney-chat.mindovermoney-ai.workers.dev/chat";
  if (!CHAT_ENDPOINT) return;
  var KEY = "mom-neura-session-v1";
  var launcher = document.getElementById("mom-chat-launcher");
  var panel = document.getElementById("mom-chat-panel");
  var body = document.getElementById("mom-chat-body");
  var input = document.getElementById("mom-chat-text");
  var sendBtn = document.getElementById("mom-chat-send");
  var busy = false, controller = null, generation = 0, saveTimer = null;
  var state = { version: 1, open: false, draft: "", messages: [] };

  function safeSources(sources) {
    if (!Array.isArray(sources)) return [];
    return sources.slice(0, 6).filter(function (s) {
      try { return s && typeof s.title === "string" && new URL(s.url).protocol === "https:"; }
      catch (_) { return false; }
    }).map(function (s) { return { title: s.title.slice(0, 300), url: String(s.url).slice(0, 2000), type: typeof s.type === "string" ? s.type.slice(0, 100) : "", kind: s.kind === "navigation" ? "navigation" : "source" }; });
  }
  function restore() {
    try {
      var raw = window.sessionStorage.getItem(KEY);
      if (!raw) return;
      if (raw.length > 250000) throw Error("state limit");
      var saved = JSON.parse(raw);
      if (!saved || saved.version !== 1 || !Array.isArray(saved.messages) || saved.messages.length > 40 || saved.messages.length % 2 !== 0) throw Error("invalid state");
      var messages = saved.messages.map(function (m, i) {
        if (!m || m.role !== (i % 2 ? "assistant" : "user") || (m.role === "user" && m.status !== "complete") || !["user", "assistant"].includes(m.role) || typeof m.content !== "string" || !["complete", "pending", "interrupted", "error"].includes(m.status)) throw Error("invalid message");
        return { role: m.role, content: m.content.slice(0, m.role === "user" ? 2000 : 16000), status: m.status === "pending" ? "interrupted" : m.status, sources: m.status === "complete" ? safeSources(m.sources) : [] };
      });
      state = { version: 1, open: saved.open === true, draft: typeof saved.draft === "string" ? saved.draft.slice(0, 2000) : "", messages: messages };
    } catch (_) { try { window.sessionStorage.removeItem(KEY); } catch (_) {} }
  }
  function save() {
    clearTimeout(saveTimer); saveTimer = null;
    state.draft = input.value.slice(0, 2000);
    // Keep complete turn boundaries and a bounded recent conversation.
    while (state.messages.length > 40 || JSON.stringify(state).length > 240000) state.messages.splice(0, 2);
    try { window.sessionStorage.setItem(KEY, JSON.stringify(state)); } catch (_) { /* Memory-only chat still works. */ }
  }
  function saveSoon() { if (!saveTimer) saveTimer = setTimeout(save, 150); }
  function open(prefill) {
    state.open = true; panel.classList.add("open"); save();
    if (prefill) { input.value = prefill; send(); } else input.focus();
  }
  function close() { state.open = false; panel.classList.remove("open"); save(); }
  function reset() {
    generation++; if (controller) controller.abort(); controller = null; busy = false; sendBtn.disabled = false;
    state.messages = []; input.value = ""; input.style.height = "auto";
    save(); renderConversation(); input.focus();
  }
  window.MindOverMoneyChat = { open: function () { open(); }, ask: function (q) { open(q); }, close: close, toggle: function () { state.open ? close() : open(); } };
  launcher.addEventListener("click", function () { state.open ? close() : open(); });
  document.getElementById("mom-chat-close").addEventListener("click", close);
  document.getElementById("mom-chat-reset").addEventListener("click", reset);
  input.addEventListener("input", function () { input.style.height = "auto"; input.style.height = Math.min(input.scrollHeight, 100) + "px"; saveSoon(); });
  input.addEventListener("keydown", function (e) { if (e.key === "Enter" && !e.shiftKey) { e.preventDefault(); send(); } });
  sendBtn.addEventListener("click", send);
  window.addEventListener("pagehide", function () {
    generation++; if (controller) controller.abort(); controller = null; busy = false; sendBtn.disabled = false;
    state.messages.forEach(function (m) { if (m.status === "pending") m.status = "interrupted"; });
    save();
  });
  // Back/forward cache can restore this document without re-running its script.
  window.addEventListener("pageshow", function (e) {
    if (!e.persisted) return;
    state = { version: 1, open: false, draft: "", messages: [] }; restore();
    input.value = state.draft; panel.classList.toggle("open", state.open); renderConversation();
  });
  document.addEventListener("visibilitychange", function () { if (document.visibilityState === "hidden") save(); });

  function el(cls, html) { var d = document.createElement("div"); d.className = cls; if (html != null) d.innerHTML = html; return d; }
  function escapeHtml(s) { return String(s).replace(/[&<>"']/g, function (c) { return { "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[c]; }); }
  function renderMarkdown(text) { return escapeHtml(text).replace(/\*\*([^*]+)\*\*/g, "<strong>$1</strong>").replace(/(^|\n)\s*[-*]\s+/g, "$1• ").replace(/\n{2,}/g, "<br><br>").replace(/\n/g, "<br>"); }
  function renderConversation() {
    body.textContent = "";
    if (!state.messages.length) { var welcome = el("mom-chat-msg bot"); welcome.appendChild(el("bubble", "Hi, I'm Neura — ask me anything about Santosh's writing on AI and I'll point you to the most useful pieces. What are you working on?")); body.appendChild(welcome); }
    state.messages.forEach(function (m, i) {
      var row = el("mom-chat-msg " + (m.role === "user" ? "user" : "bot"));
      var bubble = el("bubble", m.role === "user" ? escapeHtml(m.content) : renderMarkdown(m.content || (m.status === "pending" ? "…" : "")));
      row.appendChild(bubble); body.appendChild(row);
      if (m.role === "assistant" && m.status === "complete") renderSources(row, m.sources);
      if (m.role === "assistant" && (m.status === "interrupted" || m.status === "error")) {
        row.appendChild(el("mom-chat-notice", m.status === "interrupted" ? "This reply was interrupted. Retry when you're ready." : "The reply couldn't finish. Please try again."));
        if (i === state.messages.length - 1 && i > 0 && state.messages[i - 1].role === "user") {
          var retry = document.createElement("button"); retry.className = "mom-chat-retry"; retry.textContent = "Retry reply";
          retry.addEventListener("click", function () { if (!busy) { m.status = "pending"; m.content = ""; m.sources = []; save(); stream(m, state.messages[i - 1].content); } }); row.appendChild(retry);
        }
      }
    });
    body.scrollTop = body.scrollHeight;
  }
  function requestMessages(question) {
    var messages = [];
    for (var i = 0; i + 1 < state.messages.length; i += 2) {
      var u = state.messages[i], a = state.messages[i + 1];
      if (u.role === "user" && a.role === "assistant" && a.status === "complete") messages.push({role:"user",content:u.content},{role:"assistant",content:a.content});
    }
    messages.push({role:"user",content:question});
    while (new TextEncoder().encode(JSON.stringify({messages:messages})).length > 22000 && messages.length > 1) messages.splice(0, 2);
    return messages;
  }
  function send() {
    var text = input.value.trim().slice(0, 2000); if (!text || busy) return;
    state.messages.push({role:"user",content:text,status:"complete",sources:[]});
    var reply = {role:"assistant",content:"",status:"pending",sources:[]}; state.messages.push(reply);
    input.value = ""; input.style.height = "auto"; save(); stream(reply, text);
  }
  function stream(reply, question) {
    busy = true; sendBtn.disabled = true; controller = new AbortController(); var token = ++generation;
    renderConversation(); var bubble = body.lastChild.firstChild; var done = false, failed = false, buf = "";
    fetch(CHAT_ENDPOINT, {method:"POST",headers:{"content-type":"application/json"},body:JSON.stringify({messages:requestMessages(question)}),signal:controller.signal})
      .then(function (res) {
        if (!res.ok || !res.body) throw Error("Request failed");
        var reader = res.body.getReader(), decoder = new TextDecoder();
        function event(block) {
          if (token !== generation) return;
          var ev = "", data = ""; block.split("\n").forEach(function (line) { if (line.indexOf("event:") === 0) ev = line.slice(6).trim(); else if (line.indexOf("data:") === 0) data += line.slice(5).trim(); });
          if (!data) return;
          if (ev === "sources") { try { reply.sources = safeSources(JSON.parse(data)); } catch (_) {} }
          if (ev === "token") { var part = JSON.parse(data); if (typeof part !== "string" || reply.content.length + part.length > 16000) throw Error("Invalid reply"); reply.content += part; bubble.innerHTML = renderMarkdown(reply.content); body.scrollTop = body.scrollHeight; saveSoon(); }
          if (ev === "error") failed = true;
          if (ev === "done") done = true;
        }
        function pump() { return reader.read().then(function (r) {
          if (token !== generation) { reader.cancel().catch(function () {}); return; }
          if (r.done) { if (!done || failed || !reply.content) throw Error("Incomplete reply"); return; }
          buf += decoder.decode(r.value, {stream:true}); if (buf.length > 100000) throw Error("Invalid stream");
          var parts = buf.split("\n\n"); buf = parts.pop(); parts.forEach(event); return pump();
        }); }
        return pump();
      }).then(function () { if (token === generation) settle("complete"); })
      .catch(function () { if (token === generation) settle("error"); });
    function settle(status) { reply.status = status; if (status !== "complete") { reply.sources = []; if (controller) controller.abort(); } busy = false; sendBtn.disabled = false; controller = null; save(); renderConversation(); }
  }

  restore(); input.value = state.draft; launcher.hidden = false; panel.classList.toggle("open", state.open); renderConversation(); save();

  function renderSources(msgEl, sources) {
    if (!sources || !sources.length) return;
    var wrap = el("mom-chat-sources");
    var navigation = sources.every(function (s) { return s.kind === "navigation"; });
    wrap.appendChild(el("label", navigation ? "Links" : "Sources"));
    sources.slice(0, navigation ? 6 : 4).forEach(function (s) {
      var a = document.createElement("a");
      a.href = s.url;
      a.textContent = s.title + (s.type ? " — " + s.type : "");
      wrap.appendChild(a);
    });
    msgEl.appendChild(wrap);
    body.scrollTop = body.scrollHeight;
  }
})();
</script>
