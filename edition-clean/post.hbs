{{!< default}}
<main class="site-main">
    {{#post}}
        {{> "content" width="wide"}}
    {{/post}}

    {{!-- Fallback for posts without an authored signup card. --}}
    {{#if @site.members_enabled}}{{#unless @site.members_invite_only}}{{#unless @member}}
    <section class="ngw-post-cta gh-canvas">
        <div class="ngw-post-cta-box">
            <p class="ngw-post-cta-headline">Make AI useful in your everyday work.</p>
            <p class="ngw-post-cta-sub">One email every Tuesday, alternating NGW issues and podcast takeaways.</p>
            <a class="ngw-post-cta-btn" href="#/portal/signup/free">Subscribe for free</a>
        </div>
    </section>
    {{/unless}}{{/unless}}{{/if}}

    {{#if @custom.show_related_posts}}
        {{> "related-posts"}}
    {{/if}}
    {{#post}}
        {{> "comments"}}
    {{/post}}
</main>

{{!-- Post CTA styles --}}
<style>
  /* End-of-post CTA */
  .ngw-post-cta {
    max-width: 720px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }
  .ngw-post-cta-box {
    background: #eef3f4;
    border-left: 3px solid #8abfc5;
    border-radius: 8px;
    padding: 2rem 2.5rem;
    text-align: left;
    margin: 2rem 0 3rem;
  }
  .ngw-post-cta-headline {
    font-family: var(--gh-font-heading, var(--font-sans));
    font-size: 1.8rem;
    font-weight: 700;
    color: #2c353c;
    margin: 0 0 0.5rem;
  }
  .ngw-post-cta-sub {
    font-size: 1.4rem;
    color: #666;
    margin: 0 0 1.2rem;
    line-height: 1.5;
  }
  .ngw-post-cta-btn {
    display: inline-block;
    padding: 10px 24px;
    background: #f3e2ae;
    color: #2c353c;
    font-weight: 700;
    font-size: 1.4rem;
    border-radius: 6px;
    text-decoration: none;
    transition: background 0.2s;
  }
  .ngw-post-cta-btn:hover { background: #e8d49a; }

  @media (max-width: 600px) {
    .ngw-post-cta-box {
      padding: 1.5rem;
    }
  }
</style>
