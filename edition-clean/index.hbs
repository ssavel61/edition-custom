  body.home-template .gh-head-menu::after {
    display: none !important;
    border: none !important;
  }

  body.home-template .gh-head a,
  body.home-template .gh-head-menu a,
  body.home-template .gh-head-menu .nav a {
    color: rgba(255,255,255,0.85) !important;
  }
  body.home-template .gh-head a:hover,
  body.home-template .gh-head-menu a:hover {
    color: #f3e2ae !important;
  }

  body.home-template .gh-head-actions .gh-btn,
  body.home-template .gh-head-actions .gh-primary-btn,
  body.home-template .gh-head-actions .gh-head-btn {
    color: #2c353c !important;
    background: #f3e2ae !important;
    border-color: #f3e2ae !important;
  }
  body.home-template .gh-head-actions .gh-btn:hover,
  body.home-template .gh-head-actions .gh-primary-btn:hover,
  body.home-template .gh-head-actions .gh-head-btn:hover {
    background: #e8d49a !important;
    border-color: #e8d49a !important;
  }

  body.home-template .gh-head-logo,
  body.home-template .gh-head-logo a,
  body.home-template .gh-head-logo img {
    color: #fff !important;
  }

  body.home-template .gh-search,
  body.home-template .gh-head-actions a:not(.gh-btn):not(.gh-primary-btn):not(.gh-head-btn),
  body.home-template .gh-head-link {
    color: rgba(255,255,255,0.85) !important;
  }

  body.home-template .site-content {
    padding: 0 !important;
    margin: 0 !important;
  }

  body.home-template .gh-foot,
  body.home-template .gh-foot-inner {
    background: #2c353c !important;
    border: none !important;
  }
  body.home-template .gh-foot a,
  body.home-template .gh-copyright,
  body.home-template .gh-powered-by,
  body.home-template .gh-powered-by a,
  body.home-template .gh-foot-menu a {
    color: rgba(255,255,255,0.5) !important;
  }
  body.home-template .gh-foot a:hover,
  body.home-template .gh-foot-menu a:hover {
    color: rgba(255,255,255,0.8) !important;
  }


  /* ===== HOMEPAGE LAYOUT ===== */
  .ngw-home .site-content { padding: 0 !important; }

  /* ===== HERO ===== */
  .ngw-hero {
    background: #2c353c;
    padding: 8vmin 4vmin 6vmin;
    text-align: center;
  }
  .ngw-hero-inner {
    max-width: 720px;
    margin: 0 auto;
  }
  .ngw-hero-tagline {
    font-family: var(--gh-font-heading, var(--font-sans));
    font-size: clamp(2.4rem, 5vw, 3.8rem);
    font-weight: 800;
    line-height: 1.15;
    color: #fff;
    margin: 0 0 1.2rem;
    letter-spacing: -0.02em;
  }
  .ngw-hero-tagline em {
    font-style: normal;
    color: #f3e2ae;
  }
  .ngw-hero-sub {
    font-size: clamp(1.4rem, 2.5vw, 1.8rem);
    color: #8abfc5;
    margin: 0 0 2.5rem;
    font-weight: 600;
    letter-spacing: 0.02em;
  }
  .ngw-hero-form {
    display: flex;
    max-width: 460px;
    margin: 0 auto 1rem;
    gap: 0;
  }
  .ngw-hero-form input[type="email"] {
    flex: 1;
    height: 50px;
    padding: 0 16px;
    border: 2px solid rgba(138,191,197,0.3);
    border-right: none;
    border-radius: 6px 0 0 6px;
    background: rgba(255,255,255,0.08);
    color: #fff;
    font-size: 1.5rem;
    outline: none;
    transition: border-color 0.2s;
  }
  .ngw-hero-form input[type="email"]::placeholder {
    color: rgba(255,255,255,0.4);
  }
  .ngw-hero-form input[type="email"]:focus {
    border-color: #8abfc5;
    background: rgba(255,255,255,0.12);
  }
  .ngw-hero-form button {
    height: 50px;
    padding: 0 24px;
    background: #f3e2ae;
    color: #2c353c;
    font-weight: 700;
    font-size: 1.4rem;
    border: none;
    border-radius: 0 6px 6px 0;
    cursor: pointer;
    white-space: nowrap;
    transition: background 0.2s;
  }
  .ngw-hero-form button:hover {
    background: #e8d49a;
  }
  .ngw-hero-form .loader,
  .ngw-hero-form .success { display: none; }
  .ngw-hero-proof {
    font-size: 1.3rem;
    color: rgba(255,255,255,0.55);
    margin: 0;
    letter-spacing: 0.01em;
  }

  @media (max-width: 520px) {
    .ngw-hero-form {
      flex-direction: column;
      gap: 8px;
    }
    .ngw-hero-form input[type="email"] {
      border-right: 2px solid rgba(138,191,197,0.3);
      border-radius: 6px;
    }
    .ngw-hero-form button {
      border-radius: 6px;
      height: 46px;
    }
  }

  /* ===== VALUE PROP BOXES ===== */
  .ngw-value {
    padding: 6vmin 4vmin;
    background: #eef3f4;
  }
  .ngw-value-inner {
    max-width: 1000px;
    margin: 0 auto;
  }
  .ngw-value-heading {
    text-align: center;
    font-size: clamp(1.8rem, 3vw, 2.4rem);
    font-weight: 800;
    margin: 0 0 3rem;
    color: #2c353c;
  }
  .ngw-value-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
  }
  .ngw-value-card {
    padding: 2.4rem 2rem;
    border-radius: 10px;
    background: #fff;
    border: 1px solid #d5dee0;
    border-top: 3px solid #8abfc5;
    transition: box-shadow 0.2s, transform 0.2s;
  }
  .ngw-value-card:hover {
    box-shadow: 0 6px 24px rgba(44,53,60,0.10);
    transform: translateY(-2px);
  }
  .ngw-value-icon {
    font-size: 2.4rem;
    margin-bottom: 1rem;
  }
  .ngw-value-card h3 {
    font-size: 1.7rem;
    font-weight: 700;
    margin: 0 0 0.8rem;
    color: #2c353c;
  }
  .ngw-value-card p {
    font-size: 1.4rem;
    line-height: 1.6;
    color: #5a6872;
    margin: 0;
  }

  @media (max-width: 768px) {
    .ngw-value-grid {
      grid-template-columns: 1fr;
      gap: 1.2rem;
    }
  }

  /* ===== FEATURED CONTENT (DARK BACKGROUND) ===== */
  .ngw-featured {
    padding: 6vmin 4vmin;
    background: #2c353c;
  }
  .ngw-featured-inner {
    max-width: 1000px;
    margin: 0 auto;
  }
  .ngw-featured-heading {
    text-align: center;
    font-size: clamp(1.8rem, 3vw, 2.4rem);
    font-weight: 800;
    margin: 0 0 1rem;
    color: #fff;
  }
  .ngw-featured-sub {
    text-align: center;
    font-size: 1.5rem;
    color: rgba(255,255,255,0.6);
    margin: 0 0 3rem;
  }
  .ngw-featured-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
  }
  .ngw-featured-card {
    background: #fff;
    border-radius: 10px;
    overflow: hidden;
    border: none;
    transition: box-shadow 0.2s, transform 0.2s;
    display: flex;
    flex-direction: column;
  }
  .ngw-featured-card:hover {
    box-shadow: 0 8px 32px rgba(0,0,0,0.25);
    transform: translateY(-3px);
  }
  .ngw-featured-card a {
    text-decoration: none;
    color: inherit;
    display: flex;
    flex-direction: column;
    height: 100%;
  }
  .ngw-featured-img {
    width: 100%;
    height: 180px;
    object-fit: cover;
    display: block;
  }
  .ngw-featured-body {
    padding: 1.6rem;
    flex: 1;
    display: flex;
    flex-direction: column;
  }
  .ngw-featured-tag {
    font-size: 1.1rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: #46727b;
    margin: 0 0 0.6rem;
  }
  .ngw-featured-card h3 {
    font-size: 1.6rem;
    font-weight: 700;
    line-height: 1.3;
    margin: 0 0 0.6rem;
    color: #2c353c;
  }
  .ngw-featured-card p {
    font-size: 1.3rem;
    line-height: 1.5;
    color: #2c353c;
    margin: 0;
    flex: 1;
  }

  @media (max-width: 768px) {
    .ngw-featured-grid {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }
  }

  /* ===== ABOUT SECTION ===== */
  .ngw-about {
    padding: 6vmin 4vmin;
    background: #2c353c;
    border-bottom: 2px solid rgba(138,191,197,0.3);
  }
  .ngw-about-inner {
    max-width: 800px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    gap: 3rem;
  }
  .ngw-about-photo {
    width: 140px;
    height: 140px;
    border-radius: 50%;
    object-fit: cover;
    flex-shrink: 0;
    border: 3px solid #8abfc5;
  }
  .ngw-about-text h2 {
    font-size: 2rem;
    font-weight: 800;
    margin: 0 0 1rem;
    color: #fff;
  }
  .ngw-about-text p {
    font-size: 1.5rem;
    line-height: 1.7;
    color: rgba(255,255,255,0.75);
    margin: 0 0 1.2rem;
  }
  .ngw-about-link {
    font-size: 1.4rem;
    font-weight: 600;
    color: #f3e2ae;
    text-decoration: none;
  }
  .ngw-about-link:hover {
    text-decoration: underline;
  }

  @media (max-width: 600px) {
    .ngw-about-inner {
      flex-direction: column;
      text-align: center;
    }
  }

  /* ===== LATEST ISSUES ===== */
  .ngw-latest {
    padding: 6vmin 4vmin;
    background: #eef3f4;
  }
  .ngw-latest-inner {
    max-width: 800px;
    margin: 0 auto;
  }
  .ngw-latest-heading {
    font-size: clamp(1.8rem, 3vw, 2.4rem);
    font-weight: 800;
    margin: 0 0 2.5rem;
    text-align: center;
    color: #2c353c;
  }
  .ngw-latest-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .ngw-latest-item {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    padding: 1.4rem 0;
    border-bottom: 1px solid #d0d8db;
  }
  .ngw-latest-item:first-child {
    border-top: 1px solid #d0d8db;
  }
  .ngw-latest-item a {
    font-size: 1.6rem;
    font-weight: 600;
    color: #2c353c;
    text-decoration: none;
    flex: 1;
    margin-right: 1rem;
    line-height: 1.4;
  }
  .ngw-latest-item a:hover {
    color: #8abfc5;
  }
  .ngw-latest-date {
    font-size: 1.3rem;
    color: #5a6872;
    white-space: nowrap;
    flex-shrink: 0;
  }
  .ngw-latest-cta {
    text-align: center;
    margin-top: 2.5rem;
  }
  .ngw-latest-cta a {
    font-size: 1.4rem;
    font-weight: 600;
    color: #8abfc5;
    text-decoration: none;
  }
  .ngw-latest-cta a:hover {
    text-decoration: underline;
  }
  @media (max-width: 520px) {
    .ngw-latest-item { flex-direction: column; gap: 6px; }
    .ngw-latest-item a { margin-right: 0; overflow-wrap: anywhere; }
  }

  /* ===== SUPPORT SECTION ===== */
  .ngw-support {
    padding: 6vmin 4vmin;
    background: #2c353c;
    text-align: center;
  }
  .ngw-support-inner {
    max-width: 600px;
    margin: 0 auto;
  }
  .ngw-support h2 {
    font-size: clamp(1.8rem, 3vw, 2.4rem);
    font-weight: 800;
    color: #fff;
    margin: 0 0 1rem;
  }
  .ngw-support p {
    font-size: 1.5rem;
    line-height: 1.7;
    color: rgba(255,255,255,0.7);
    margin: 0 0 2rem;
  }
  .ngw-support-btn {
    display: inline-block;
    padding: 12px 32px;
    background: #f3e2ae;
    color: #2c353c;
    font-weight: 700;
    font-size: 1.5rem;
    border-radius: 6px;
    text-decoration: none;
    transition: background 0.2s;
  }
  .ngw-support-btn:hover {
    background: #e8d49a;
  }

.ngw-signup { max-width: 510px; margin: 0 auto; text-align: left; }
.ngw-signup label { display: block; color: #e1e7e9; font-size: 1.4rem; margin-bottom: 8px; }
.ngw-signup .ngw-hero-form { max-width: none; margin-bottom: 10px; }
.ngw-hero-form input[type="email"] { min-width: 0; min-height: 50px; flex: 1 1 auto; }
.ngw-hero-form input[type="email"]::placeholder { color: #c2ccd2; }
.ngw-hero-form button { flex: 0 0 auto; }
.ngw-hero-form button:disabled { cursor: wait; }
.ngw-hero-proof { color: #c2ccd2; text-align: center; }
.ngw-feedback { color: #fff; background: #36454d; border-left: 3px solid #8abfc5; padding: 12px 14px; margin: 12px 0 0; font-size: 1.4rem; line-height: 1.5; }
.ngw-feedback[data-kind="error"] { border-color: #f3e2ae; }
.ngw-value-card { display: flex; flex-direction: column; }
.ngw-card-type { color: #52616b; font-size: 1.2rem; font-weight: 700; letter-spacing: .07em; text-transform: uppercase; margin-bottom: 14px; }
.ngw-value-card p { flex-grow: 1; }
.ngw-benefits + .ngw-value { padding-top: 0; }
.ngw-benefits .ngw-value-card:hover { transform: none; box-shadow: none; }
.ngw-card-link { display: inline-block; margin-top: 20px; color: #2c353c; font-size: 1.4rem; font-weight: 700; text-decoration: underline; text-underline-offset: 4px; }
.ngw-card-link:is(button) { align-self: flex-start; border: 0; padding: 0; background: none; cursor: pointer; font-family: inherit; }
.ngw-featured-sub { color: #c2ccd2; }

</style>
<main class="site-main ngw-home">
<section class="ngw-hero"><div class="ngw-hero-inner">
<h1 class="ngw-hero-tagline">Make AI Useful In <em>Your Everyday Work.</em></h1>
<p class="ngw-hero-sub">No Hype. No Fear. Just Workflows.</p>
<div class="ngw-signup" id="signup">{{> ngw-signup form_id="home"}}</div>
</div></section>
<section class="ngw-value ngw-benefits" aria-labelledby="benefits-title"><div class="ngw-value-inner">
<h2 class="ngw-value-heading" id="benefits-title">What you get every week</h2>
<div class="ngw-value-grid">
<article class="ngw-value-card"><div class="ngw-value-icon" aria-hidden="true">📚</div><h3>Learn AI Concepts</h3><p>Each issue unpacks one AI concept with zero jargon. No CS degree required. Just clear explanations tied to real work scenarios you'll recognize from your own week.</p></article>
<article class="ngw-value-card"><div class="ngw-value-icon" aria-hidden="true">⚡</div><h3>Steal Real Prompts</h3><p>The exact prompts I use every week. The model, the context, what worked, what didn't. Copy them. Tweak them. Ship them. No theory. Just receipts.</p></article>
<article class="ngw-value-card"><div class="ngw-value-icon" aria-hidden="true">🛠️</div><h3>Build Alongside Me</h3><p>A non-technical professional building with AI in public. Every win, every failure, every workflow documented. You skip the mistakes. You keep the shortcuts.</p></article>
</div></div></section>
<section class="ngw-value" aria-labelledby="ways-title"><div class="ngw-value-inner"><h2 class="ngw-value-heading" id="ways-title">Read. Watch. Explore. Put it to work.</h2>
<div class="ngw-value-grid">
<article class="ngw-value-card"><div class="ngw-card-type">The newsletter</div><h3>Neural Gains Weekly</h3><p>Understand an AI concept, try a practical prompt, and see what Santosh is learning as he builds.</p><a class="ngw-card-link" href="/how-to-evaluate-ai-tool-safety-at-work/">Read a recent issue →</a></article>
<article class="ngw-value-card" id="podcast"><div class="ngw-card-type">The podcast</div><h3>Explore AI Out Loud</h3><p>Santosh and Brandon compare their experiences using AI: what worked, what didn’t, and what they’re trying next.</p><a class="ngw-card-link" href="/podcast/">Explore the podcast →</a></article>
<article class="ngw-value-card" id="neura"><div class="ngw-card-type">Your guide to the archive</div><h3>Neura</h3><p>Looking for something specific? Ask a question and follow Neura’s links to relevant published articles.</p><button class="ngw-card-link" type="button" data-open-neura>Ask Neura →</button></article>
</div></div></section>
<section class="ngw-featured"><div class="ngw-featured-inner"><h2 class="ngw-featured-heading">Start with these</h2><p class="ngw-featured-sub">Not sure where to begin? These three posts capture what Neural Gains Weekly is all about.</p>
<div class="ngw-featured-grid">
{{#get "posts" filter="featured:true" limit="3" include="tags" order="published_at desc"}}{{#foreach posts}}
<article class="ngw-featured-card"><a href="{{url}}"><div class="ngw-featured-body">
<div class="ngw-featured-tag">{{#has tag="#founders-corner"}}Founder's Corner{{else}}{{#has tag="#prompt-library"}}Steal My Prompt{{else}}Neural Gains Weekly{{/has}}{{/has}}</div>
<h3>{{title}}</h3><p>{{#if custom_excerpt}}{{custom_excerpt}}{{else}}{{excerpt words="26"}}{{/if}}</p>
</div></a></article>
{{/foreach}}{{/get}}
</div></div></section>
<section class="ngw-latest" aria-labelledby="latest-title"><div class="ngw-latest-inner">
<h2 class="ngw-latest-heading" id="latest-title">Latest updates</h2>
<ul class="ngw-latest-list" id="latest-updates">
{{#get "posts" limit="4" order="published_at desc"}}{{#foreach posts}}
<li class="ngw-latest-item" data-article="true" data-published-at="{{date published_at format="YYYY-MM-DDTHH:mm:ss.SSS[Z]" timezone="UTC"}}">
<a href="{{url}}">{{title}}</a><time class="ngw-latest-date" datetime="{{date published_at format="YYYY-MM-DDTHH:mm:ss.SSS[Z]" timezone="UTC"}}">{{date published_at format="MMM D, YYYY"}}</time>
</li>
{{/foreach}}{{/get}}
</ul>
<p id="episode-status" class="visually-hidden" role="status" aria-live="polite"></p>
<div class="ngw-latest-cta"><a href="/archive/">Browse the full archive →</a></div>
</div></section>
</main>
