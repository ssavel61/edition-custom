{{!< default}}
<style>

  body.home-template,
  body.home-template .site {
    background: #2c353c !important;
  }

  body.home-template .gh-head {
    background: #2c353c !important;
    border: none !important;
    border-bottom: 4px solid rgba(138,191,197,0.3) !important;
