    outline: none !important;
  }
  body.home-template .gh-head-inner,
  body.home-template .gh-head-brand,
  body.home-template .gh-head-brand-wrapper,
  body.home-template .gh-head-menu,
  body.home-template .gh-head-actions {
    background: #2c353c !important;
    border: none !important;
    box-shadow: none !important;
    outline: none !important;
  }

  body.home-template .gh-head::before,
  body.home-template .gh-head::after,
  body.home-template .gh-head-inner::before,
  body.home-template .gh-head-inner::after,
  body.home-template .gh-head-brand::before,
  body.home-template .gh-head-brand::after,
  body.home-template .gh-head-brand-wrapper::after,
