{{!< default}}

<main class="site-main">

    {{#post}}
        {{> "content" width="wide"}}
        {{!-- Closing bands key on the page slug; renaming a slug in Ghost removes its band. --}}
        {{#match slug "start-here"}}{{> "page-band" form_id="start-here" show_newsletter=true}}{{/match}}
        {{#match slug "about"}}{{> "page-band" form_id="about" show_newsletter=true}}{{/match}}
        {{#match slug "welcome"}}{{> "page-band" form_id="welcome" show_newsletter=false}}{{/match}}
    {{/post}}

</main>

{{!-- Page band styles --}}
<style>
  .ngw-page-band { max-width: 720px; margin: 0 auto; padding: 0 1.5rem 4rem; }
  .ngw-page-band-inner { border-top: 1px solid #d6e0e3; padding-top: 2.5rem; }
  .ngw-page-band-news { background: #eef3f4; border-left: 3px solid #8abfc5; border-radius: 8px; padding: 2rem 2.5rem; margin: 0 0 2rem; }
  .ngw-page-band-heading { font-family: var(--gh-font-heading, var(--font-sans)); font-size: 2.2rem; font-weight: 700; color: #2c353c; margin: 0 0 0.6rem; letter-spacing: -0.02em; }
  .ngw-page-band-sub { font-size: 1.5rem; color: #53626a; line-height: 1.6; margin: 0 0 1.4rem; }
  .ngw-page-band-news .ngw-signup-form { margin: 0; }
  @media (max-width: 600px) {
    .ngw-page-band-news { padding: 1.5rem; }
    .ngw-page-band-heading { font-size: 2rem; }
  }
</style>
